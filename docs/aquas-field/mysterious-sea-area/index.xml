      <guid>https://tikri.site/aquas-field/mysterious-sea-area/%E8%B4%A2%E5%8A%A1%E8%AE%B0%E5%BD%95%E6%A8%A1%E6%9D%BF/</guid>
      <description>&lt;h1 id=&#34;财务记录模板&#34;&gt;财务记录模板&lt;/h1&gt;&#xA;&lt;h3 id=&#34;-月度收支汇总&#34;&gt;📊 月度收支汇总&lt;/h3&gt;&#xA;&lt;h4 id=&#34;收入统计&#34;&gt;收入统计&lt;/h4&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;工资收入：20000元&lt;/li&gt;&#xA;&lt;li&gt;兼职收入：1200元&lt;/li&gt;&#xA;&lt;li&gt;投资收入：500元&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;总收入：21700元&lt;/strong&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h4 id=&#34;支出统计&#34;&gt;支出统计&lt;/h4&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;餐饮：1800元&lt;/li&gt;&#xA;&lt;li&gt;交通：400元&lt;/li&gt;&#xA;&lt;li&gt;购物：2500元&lt;/li&gt;&#xA;&lt;li&gt;娱乐：800元&lt;/li&gt;&#xA;&lt;li&gt;其他：1200元&lt;/li&gt;&#xA;&lt;li&gt;&lt;strong&gt;总支出：6700元&lt;/strong&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h4 id=&#34;财务分析&#34;&gt;财务分析&lt;/h4&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;净收入：15000元&lt;/li&gt;&#xA;&lt;li&gt;储蓄率：69.1%&lt;/li&gt;&#xA;&lt;li&gt;平均每日支出：216元&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h3 id=&#34;-可视化图表&#34;&gt;📈 可视化图表&lt;/h3&gt;&#xA;&lt;h4 id=&#34;支出分布饼图&#34;&gt;支出分布饼图&lt;/h4&gt;&#xA;&lt;div class=&#34;mermaid&#34;&gt;&#xA;&#xA;pie title 2024年1月支出分布&#xA;    &#34;餐饮&#34; : 1800&#xA;    &#34;交通&#34; : 400&#xA;    &#34;购物&#34; : 2500&#xA;    &#34;娱乐&#34; : 800&#xA;    &#34;其他&#34; : 1200&#xA;&#xA;&lt;/div&gt;&#xA;&#xD;&#xA;&lt;script&gt;&#xD;&#xA;  &#xD;&#xA;  function loadMermaid() {&#xD;&#xA;    if (document.querySelector(&#39;.mermaid&#39;)) {&#xD;&#xA;      const script = document.createElement(&#39;script&#39;);&#xD;&#xA;      script.src = &#39;https://cdn.jsdelivr.net/npm/mermaid@10.6.1/dist/mermaid.min.js&#39;;&#xD;&#xA;      script.async = true;&#xD;&#xA;      script.onload = function() {&#xD;&#xA;        mermaid.initialize({&#xD;&#xA;          startOnLoad: true,&#xD;&#xA;          theme: &#39;default&#39;,&#xD;&#xA;          securityLevel: &#39;loose&#39;,&#xD;&#xA;          flowchart: {&#xD;&#xA;            useMaxWidth: true,&#xD;&#xA;            htmlLabels: true&#xD;&#xA;          },&#xD;&#xA;          pie: {&#xD;&#xA;            useMaxWidth: true&#xD;&#xA;          },&#xD;&#xA;          xychart: {&#xD;&#xA;            useMaxWidth: true&#xD;&#xA;          }&#xD;&#xA;        });&#xD;&#xA;      };&#xD;&#xA;      document.head.appendChild(script);&#xD;&#xA;    }&#xD;&#xA;  }&#xD;&#xA;  &#xD;&#xA;  &#xD;&#xA;  document.addEventListener(&#39;DOMContentLoaded&#39;, loadMermaid);&#xD;&#xA;&lt;/script&gt;&#xD;&#xA;&#xD;&#xA;&#xA;&#xA;&lt;h4 id=&#34;收支对比柱状图&#34;&gt;收支对比柱状图&lt;/h4&gt;&#xA;&lt;div class=&#34;mermaid&#34;&gt;&#xA;&#xA;xychart-beta&#xA;    title &#34;2024年1月收支对比&#34;&#xA;    x-axis [&#34;收入&#34;, &#34;支出&#34;, &#34;净收入&#34;]&#xA;    y-axis &#34;金额(元)&#34; 0 --&gt; 25000&#xA;    bar [21700, 6700, 15000]&#xA;&#xA;&lt;/div&gt;&#xA;&#xD;&#xA;&lt;script&gt;&#xD;&#xA;  &#xD;&#xA;  function loadMermaid() {&#xD;&#xA;    if (document.querySelector(&#39;.mermaid&#39;)) {&#xD;&#xA;      const script = document.createElement(&#39;script&#39;);&#xD;&#xA;      script.src = &#39;https://cdn.jsdelivr.net/npm/mermaid@10.6.1/dist/mermaid.min.js&#39;;&#xD;&#xA;      script.async = true;&#xD;&#xA;      script.onload = function() {&#xD;&#xA;        mermaid.initialize({&#xD;&#xA;          startOnLoad: true,&#xD;&#xA;          theme: &#39;default&#39;,&#xD;&#xA;          securityLevel: &#39;loose&#39;,&#xD;&#xA;          flowchart: {&#xD;&#xA;            useMaxWidth: true,&#xD;&#xA;            htmlLabels: true&#xD;&#xA;          },&#xD;&#xA;          pie: {&#xD;&#xA;            useMaxWidth: true&#xD;&#xA;          },&#xD;&#xA;          xychart: {&#xD;&#xA;            useMaxWidth: true&#xD;&#xA;          }&#xD;&#xA;        });&#xD;&#xA;      };&#xD;&#xA;      document.head.appendChild(script);&#xD;&#xA;    }&#xD;&#xA;  }&#xD;&#xA;  &#xD;&#xA;  &#xD;&#xA;  document.addEventListener(&#39;DOMContentLoaded&#39;, loadMermaid);&#xD;&#xA;&lt;/script&gt;&#xD;&#xA;&#xD;&#xA;&#xA;&#xA;&lt;h4 id=&#34;支出类别对比&#34;&gt;支出类别对比&lt;/h4&gt;&#xA;&lt;div class=&#34;mermaid&#34;&gt;&#xA;&#xA;xychart-beta&#xA;    title &#34;2024年1月各类支出对比&#34;&#xA;    x-axis [&#34;餐饮&#34;, &#34;交