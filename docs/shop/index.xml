    <item>
      <title>AQUA IN JAR 活动报名支付</title>
      <link>http://localhost:1313/shop/AQUA-IN-JAR-PAYMENT/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/shop/AQUA-IN-JAR-PAYMENT/</guid>
      <description>&lt;h2 id=&#34;商品详情内容&#34;&gt;商品详情内容&lt;/h2&gt;&#xA;&lt;div class=&#34;buy-button-container&#34;&gt;&#xD;&#xA;  &lt;div class=&#34;product-info&#34;&gt;&#xD;&#xA;    &lt;h3&gt;AQUA IN JAR 活动报名支付&lt;/h3&gt;&#xD;&#xA;    &lt;p class=&#34;price&#34;&gt;CNY58.00&lt;/p&gt;&#xD;&#xA;    &lt;p class=&#34;description&#34;&gt;商品描述&lt;/p&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;  &#xD;&#xA;  &lt;div class=&#34;payment-options&#34;&gt;&#xD;&#xA;    &#xD;&#xA;    &lt;button class=&#34;buy-button wechat-button&#34; onclick=&#34;showPaymentQR(&#39;wechat&#39;)&#34;&gt;&#xD;&#xA;      &lt;span class=&#34;button-icon&#34;&gt;💚&lt;/span&gt;&#xD;&#xA;      微信支付&#xD;&#xA;    &lt;/button&gt;&#xD;&#xA;    &#xD;&#xA;    &#xD;&#xA;    &lt;button class=&#34;buy-button alipay-button&#34; onclick=&#34;showPaymentQR(&#39;alipay&#39;)&#34;&gt;&#xD;&#xA;      &lt;span class=&#34;button-icon&#34;&gt;🔵&lt;/span&gt;&#xD;&#xA;      支付宝支付&#xD;&#xA;    &lt;/button&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;  &#xD;&#xA;  &#xD;&#xA;  &lt;div id=&#34;payment-qr-modal&#34; class=&#34;modal&#34; style=&#34;display: none;&#34;&gt;&#xD;&#xA;    &lt;div class=&#34;modal-content&#34;&gt;&#xD;&#xA;      &lt;span class=&#34;close&#34; onclick=&#34;hidePaymentQR()&#34;&gt;&amp;times;&lt;/span&gt;&#xD;&#xA;      &lt;div id=&#34;payment-header&#34;&gt;&#xD;&#xA;        &lt;h3 id=&#34;payment-title&#34;&gt;选择支付方式&lt;/h3&gt;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;      &#xD;&#xA;      &#xD;&#xA;      &lt;div id=&#34;wechat-payment&#34; class=&#34;payment-section&#34; style=&#34;display: none;&#34;&gt;&#xD;&#xA;        &lt;div class=&#34;payment-info&#34;&gt;&#xD;&#xA;          &lt;div class=&#34;payment-icon wechat-icon&#34;&gt;💚&lt;/div&gt;&#xD;&#xA;          &lt;div class=&#34;payment-details&#34;&gt;&#xD;&#xA;            &lt;h4&gt;微信支付&lt;/h4&gt;&#xD;&#xA;            &lt;p class=&#34;payment-amount&#34;&gt;CNY58.00&lt;/p&gt;&#xD;&#xA;            &lt;p class=&#34;payment-desc&#34;&gt;AQUA IN JAR 活动报名支付&lt;/p&gt;&#xD;&#xA;          &lt;/div&gt;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;        &lt;div class=&#34;qr-code&#34;&gt;&#xD;&#xA;          &lt;img id=&#34;wechat-qr&#34; src=&#34;http://localhost:1313/images/payment/wechat-qr.jpg&#34; alt=&#34;微信支付二维码&#34; /&gt;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;        &lt;p class=&#34;payment-instruction&#34;&gt;请使用微信扫描二维码完成支付&lt;/p&gt;&#xD;&#xA;        &lt;div class=&#34;payment-tips&#34;&gt;&#xD;&#xA;          &lt;p&gt;💡 支付完成后，请截图保存支付凭证&lt;/p&gt;&#xD;&#xA;          &lt;p&gt;📧 支付成功后，商品将发送至你的邮箱&lt;/p&gt;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;      &#xD;&#xA;      &#xD;&#xA;      &lt;div id=&#34;alipay-payment&#34; class=&#34;payment-section&#34; style=&#34;display: none;&#34;&gt;&#xD;&#xA;        &lt;div class=&#34;payment-info&#34;&gt;&#xD;&#xA;          &lt;div class=&#34;payment-icon alipay-icon&#34;&gt;🔵&lt;/div&gt;&#xD;&#xA;          &lt;div class=&#34;payment-details&#34;&gt;&#xD;&#xA;            &lt;h4&gt;支付宝支付&lt;/h4&gt;&#xD;&#xA;            &lt;p class=&#34;payment-amount&#34;&gt;CNY58.00&lt;/p&gt;&#xD;&#xA;            &lt;p class=&#34;payment-desc&#34;&gt;AQUA IN JAR 活动报名支付&lt;/p&gt;&#xD;&#xA;          &lt;/div&gt;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;        &lt;div class=&#34;qr-code&#34;&gt;&#xD;&#xA;          &lt;img id=&#34;alipay-qr&#34; src=&#34;http://localhost:1313/images/payment/alipay-qr.jpg&#34; alt=&#34;支付宝支付二维码&#34; /&gt;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;        &lt;p class=&#34;payment-instruction&#34;&gt;请使用支付宝扫描二维码完成支付&lt;/p&gt;&#xD;&#xA;        &lt;div class=&#34;payment-tips&#34;&gt;&#xD;&#xA;          &lt;p&gt;💡 支付完成后，请截图保存支付凭证&lt;/p&gt;&#xD;&#xA;          &lt;p&gt;📧 支付成功后，商品将发送至你的邮箱&lt;/p&gt;&#xD;&#xA;        &lt;/div&gt;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;      &#xD;&#xA;      &#xD;&#xA;      &lt;div class=&#34;contact-info&#34;&gt;&#xD;&#xA;        &lt;p&gt;如有问题，请联系：&lt;/p&gt;&#xD;&#xA;        &lt;p&gt;📧 aqutikri@gmail.com&lt;/p&gt;&#xD;&#xA;      &lt;/div&gt;&#xD;&#xA;    &lt;/div&gt;&#xD;&#xA;  &lt;/div&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&lt;style&gt;&#xD;&#xA;.buy-button-container {&#xD;&#xA;  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);&#xD;&#xA;  border-radius: 12px;&#xD;&#xA;  padding: 24px;&#xD;&#xA;  margin: 24px 0;&#xD;&#xA;  color: white;&#xD;&#xA;  text-align: center;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.product-info h3 {&#xD;&#xA;  margin: 0 0 8px 0;&#xD;&#xA;  font-size: 1.5em;&#xD;&#xA;  font-weight: 600;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.price {&#xD;&#xA;  font-size: 2em;&#xD;&#xA;  font-weight: bold;&#xD;&#xA;  margin: 8px 0;&#xD;&#xA;  color: #ffd700;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.description {&#xD;&#xA;  margin: 8px 0 20px 0;&#xD;&#xA;  opacity: 0.9;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.payment-options {&#xD;&#xA;  display: flex;&#xD;&#xA;  gap: 12px;&#xD;&#xA;  justify-content: center;&#xD;&#xA;  flex-wrap: wrap;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.buy-button {&#xD;&#xA;  display: inline-flex;&#xD;&#xA;  align-items: center;&#xD;&#xA;  gap: 8px;&#xD;&#xA;  padding: 12px 24px;&#xD;&#xA;  border: none;&#xD;&#xA;  border-radius: 8px;&#xD;&#xA;  font-size: 16px;&#xD;&#xA;  font-weight: 600;&#xD;&#xA;  text-decoration: none;&#xD;&#xA;  cursor: pointer;&#xD;&#xA;  transition: all 0.3s ease;&#xD;&#xA;  min-width: 140px;&#xD;&#xA;  justify-content: center;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.wechat-button {&#xD;&#xA;  background: #07c160;&#xD;&#xA;  color: white;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.wechat-button:hover {&#xD;&#xA;  background: #06ad56;&#xD;&#xA;  transform: translateY(-2px);&#xD;&#xA;  box-shadow: 0 4px 12px rgba(7, 193, 96, 0.4);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.alipay-button {&#xD;&#xA;  background: #1677ff;&#xD;&#xA;  color: white;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.alipay-button:hover {&#xD;&#xA;  background: #4096ff;&#xD;&#xA;  transform: translateY(-2px);&#xD;&#xA;  box-shadow: 0 4px 12px rgba(22, 119, 255, 0.4);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.button-icon {&#xD;&#xA;  font-size: 18px;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;.modal {&#xD;&#xA;  position: fixed;&#xD;&#xA;  z-index: 1000;&#xD;&#xA;  left: 0;&#xD;&#xA;  top: 0;&#xD;&#xA;  width: 100%;&#xD;&#xA;  height: 100%;&#xD;&#xA;  background-color: rgba(0,0,0,0.5);&#xD;&#xA;  backdrop-filter: blur(4px);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.modal-content {&#xD;&#xA;  background-color: white;&#xD;&#xA;  margin: 5% auto;&#xD;&#xA;  padding: 24px;&#xD;&#xA;  border-radius: 16px;&#xD;&#xA;  width: 90%;&#xD;&#xA;  max-width: 400px;&#xD;&#xA;  text-align: center;&#xD;&#xA;  color: #333;&#xD;&#xA;  box-shadow: 0 20px 40px rgba(0,0,0,0.2);&#xD;&#xA;  animation: modalSlideIn 0.3s ease-out;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;@keyframes modalSlideIn {&#xD;&#xA;  from {&#xD;&#xA;    opacity: 0;&#xD;&#xA;    transform: translateY(-50px);&#xD;&#xA;  }&#xD;&#xA;  to {&#xD;&#xA;    opacity: 1;&#xD;&#xA;    transform: translateY(0);&#xD;&#xA;  }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.close {&#xD;&#xA;  color: #aaa;&#xD;&#xA;  float: right;&#xD;&#xA;  font-size: 28px;&#xD;&#xA;  font-weight: bold;&#xD;&#xA;  cursor: pointer;&#xD;&#xA;  line-height: 1;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.close:hover {&#xD;&#xA;  color: #000;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.payment-section {&#xD;&#xA;  margin-top: 20px;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.payment-info {&#xD;&#xA;  display: flex;&#xD;&#xA;  align-items: center;&#xD;&#xA;  justify-content: center;&#xD;&#xA;  gap: 12px;&#xD;&#xA;  margin-bottom: 20px;&#xD;&#xA;  padding: 16px;&#xD;&#xA;  background: #f8f9fa;&#xD;&#xA;  border-radius: 8px;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.payment-icon {&#xD;&#xA;  font-size: 24px;&#xD;&#xA;  width: 40px;&#xD;&#xA;  height: 40px;&#xD;&#xA;  display: flex;&#xD;&#xA;  align-items: center;&#xD;&#xA;  justify-content: center;&#xD;&#xA;  border-radius: 50%;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.wechat-icon {&#xD;&#xA;  background: #07c160;&#xD;&#xA;  color: white;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.alipay-icon {&#xD;&#xA;  background: #1677ff;&#xD;&#xA;  color: white;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.payment-details h4 {&#xD;&#xA;  margin: 0 0 4px 0;&#xD;&#xA;  font-size: 1.1em;&#xD;&#xA;  color: #333;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.payment-amount {&#xD;&#xA;  font-size: 1.3em;&#xD;&#xA;  font-weight: bold;&#xD;&#xA;  color: #e74c3c;&#xD;&#xA;  margin: 0 0 4px 0;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.payment-desc {&#xD;&#xA;  font-size: 0.9em;&#xD;&#xA;  color: #666;&#xD;&#xA;  margin: 0;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.qr-code {&#xD;&#xA;  margin: 20px 0;&#xD;&#xA;  padding: 16px;&#xD;&#xA;  background: white;&#xD;&#xA;  border-radius: 8px;&#xD;&#xA;  border: 2px solid #e9ecef;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.qr-code img {&#xD;&#xA;  width: 200px;&#xD;&#xA;  height: 200px;&#xD;&#xA;  border-radius: 8px;&#xD;&#xA;  max-width: 100%;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.payment-instruction {&#xD;&#xA;  font-size: 14px;&#xD;&#xA;  color: #666;&#xD;&#xA;  margin: 12px 0;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.payment-tips {&#xD;&#xA;  background: #e3f2fd;&#xD;&#xA;  padding: 12px;&#xD;&#xA;  border-radius: 8px;&#xD;&#xA;  margin: 16px 0;&#xD;&#xA;  text-align: left;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.payment-tips p {&#xD;&#xA;  margin: 4px 0;&#xD;&#xA;  font-size: 13px;&#xD;&#xA;  color: #1976d2;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.contact-info {&#xD;&#xA;  margin-top: 20px;&#xD;&#xA;  padding-top: 16px;&#xD;&#xA;  border-top: 1px solid #e9ecef;&#xD;&#xA;  font-size: 14px;&#xD;&#xA;  color: #666;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;.contact-info p {&#xD;&#xA;  margin: 4px 0;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;@media (max-width: 768px) {&#xD;&#xA;  .payment-options {&#xD;&#xA;    flex-direction: column;&#xD;&#xA;    align-items: center;&#xD;&#xA;  }&#xD;&#xA;  &#xD;&#xA;  .buy-button {&#xD;&#xA;    width: 100%;&#xD;&#xA;    max-width: 200px;&#xD;&#xA;  }&#xD;&#xA;  &#xD;&#xA;  .modal-content {&#xD;&#xA;    margin: 10% auto;&#xD;&#xA;    width: 95%;&#xD;&#xA;    padding: 20px;&#xD;&#xA;  }&#xD;&#xA;  &#xD;&#xA;  .qr-code img {&#xD;&#xA;    width: 180px;&#xD;&#xA;    height: 180px;&#xD;&#xA;  }&#xD;&#xA;  &#xD;&#xA;  .payment-info {&#xD;&#xA;    flex-direction: column;&#xD;&#xA;    text-align: center;&#xD;&#xA;  }&#xD;&#xA;}&#xD;&#xA;&lt;/style&gt;&#xD;&#xA;&#xD;&#xA;&lt;script&gt;&#xD;&#xA;function showPaymentQR(paymentType) {&#xD;&#xA;  const modal = document.getElementById(&#39;payment-qr-modal&#39;);&#xD;&#xA;  const wechatSection = document.getElementById(&#39;wechat-payment&#39;);&#xD;&#xA;  const alipaySection = document.getElementById(&#39;alipay-payment&#39;);&#xD;&#xA;  const paymentTitle = document.getElementById(&#39;payment-title&#39;);&#xD;&#xA;  &#xD;&#xA;  &#xD;&#xA;  wechatSection.style.display = &#39;none&#39;;&#xD;&#xA;  alipaySection.style.display = &#39;none&#39;;&#xD;&#xA;  &#xD;&#xA;  &#xD;&#xA;  if (paymentType === &#39;wechat&#39;) {&#xD;&#xA;    wechatSection.style.display = &#39;block&#39;;&#xD;&#xA;    paymentTitle.textContent = &#39;微信支付&#39;;&#xD;&#xA;  } else if (paymentType === &#39;alipay&#39;) {&#xD;&#xA;    alipaySection.style.display = &#39;block&#39;;&#xD;&#xA;    paymentTitle.textContent = &#39;支付宝支付&#39;;&#xD;&#xA;  }&#xD;&#xA;  &#xD;&#xA;  &#xD;&#xA;  modal.style.display = &#39;block&#39;;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;function hidePaymentQR() {&#xD;&#xA;  document.getElementById(&#39;payment-qr-modal&#39;).style.display = &#39;none&#39;;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;window.onclick = function(event) {&#xD;&#xA;  const modal = document.getElementById(&#39;payment-qr-modal&#39;);&#xD;&#xA;  if (event.target == modal) {&#xD;&#xA;    modal.style.display = &#39;none&#39;;&#xD;&#xA;  }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;document.addEventListener(&#39;keydown&#39;, function(event) {&#xD;&#xA;  if (event.key === &#39;Escape&#39;) {&#xD;&#xA;    hidePaymentQR();&#xD;&#xA;  }&#xD;&#xA;});&#xD;&#xA;&lt;/script&gt;</description>
